<?xml version="1.0"?>
<package format="2">
  <name>turtlecpp</name>
  <version>0.0.1</version>
  <description>ROS Noetic turtle motion control demo in C++.</description>

  <maintainer email="matthew-xie@example.com">matthew-xie</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim</depend>

  <export/>
</package>